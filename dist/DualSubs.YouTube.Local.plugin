[Rule]
# 闃绘 YouTube / YouTube Music 浣跨敤 QUIC (UDP 443) 缁曡繃 Loon MitM 瑙ｅ瘑
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,UDP)),REJECT

[Rewrite]
# 鎷︽埅 Onesie initplayback 璇锋眰浠ヨЕ鍙戞爣鍑嗗瓧骞曞姞杞芥祦绋?^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*(oad|ack)=.+)$ reject-dict

[Script]
http-request ^https:\/\/dualsubs\.github\.io\/api\/(?:get|set|delete)(?:\?.*)?$ requires-body=1, script-path=https://github.com/NSNanoCat/PreferencePanes/releases/download/v1.3.1/api.js, tag=PreferencePanes.API
# YouTube Player & GetWatch
http-request ^https?:\/\/(www|m|tv|music)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, script-path=request.bundle.js, tag=馃嵖锔?DualSubs.YouTube.Player.request.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/(www|m|tv|music)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, script-path=response.bundle.js, tag=馃嵖锔?DualSubs.YouTube.Player.response.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-request ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=request.bundle.js, tag=馃嵖锔?DualSubs.YouTube.Player.request.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=response.bundle.js, tag=馃嵖锔?DualSubs.YouTube.Player.response.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=response.bundle.js, tag=馃嵖锔?DualSubs.YouTube.GetWatch.response.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
# YouTube TimedText (鍚堟垚鍙岃瀛楀箷 & 缈昏瘧鍙岃瀛楀箷鍚堜簩涓轰竴)
http-request ^https?:\/\/(www|m|music)\.youtube\.com\/api\/timedtext(\?.+)?$ script-path=request.bundle.js, tag=馃嵖锔?DualSubs.YouTube.TimedText.request, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/(www|m|music)\.youtube\.com\/api\/timedtext(\?.+)?$ requires-body=1, script-path=response.bundle.js, tag=馃嵖锔?DualSubs.YouTube.TimedText.response, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]

# YouTube Music Lyrics (Browse & GetPanel 鍙岃姝岃瘝鍚堜簩涓轰竴)
http-request ^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$ requires-body=1, script-path=request.bundle.js, tag=馃嵖锔?DualSubs.YouTubeMusic.Browse.request.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-request ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=request.bundle.js, tag=馃嵖锔?DualSubs.YouTube.Browse.request.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$ requires-body=1, script-path=response.bundle.js, tag=馃嵖锔?DualSubs.YouTubeMusic.Translate.Lyrics.response.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=response.bundle.js, tag=馃嵖锔?DualSubs.YouTubeMusic.Translate.Lyrics.response.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_panel(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=response.bundle.js, tag=馃嵖锔?DualSubs.YouTubeMusic.GetPanel.Translate.Lyrics.response.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/music\.youtube\.com\/youtubei\/v1\/get_panel(\?.+)?$ requires-body=1, script-path=response.bundle.js, tag=馃嵖锔?DualSubs.YouTubeMusic.GetPanel.Translate.Lyrics.response.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]

[MITM]
hostname = dualsubs.github.io, www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com


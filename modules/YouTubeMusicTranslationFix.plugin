#!name = 🍿️ DualSubs: ▶️ YouTube (Unified)
#!desc = YouTube & YouTube Music 增强及双语字幕/歌词二合一插件
#!openUrl = https://dualsubs.github.io/preferences/
#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://DualSubs.github.io/guide/youtube
#!icon = https://github.com/DualSubs/YouTube/raw/main/src/assets/icon_rounded.png
#!tag = 🍿️ DualSubs
#!system = iOS,iPadOS,macOS
#!date = 2026-11-07 08:20:29
#!version = 1.6.2
#!system_version = 15

[Argument]
Type = select,"Translate","Official",tag=[字幕] 启用类型,desc=请选择要使用的字幕，双语字幕将使用您选择类型呈现。
Types = input,"Translate",tag=[歌词] 启用类型,desc=请选择要添加的歌词选项，如果为多选，则会自动决定提供的歌词类型。
AutoCC = switch,true,tag=[字幕] 自动显示,desc=是否总是自动开启字幕显示。
Source = select,"AUTO","ZH","ZH-HANS","ZH-HK","ZH-HANT","ZH-TW","EN","EN-US","EN-GB","JA","KO","DE","FR","ES","RU","IT","PT",tag=[字幕/歌词] 主语言（源语言）,desc=选择主语言（源语言），字幕及歌词源语言将自动识别或使用指定语言。
Target = select,"ZH-HANS","ZH","ZH-HK","ZH-HANT","ZH-TW","EN","EN-US","EN-GB","JA","KO","DE","FR","ES","RU","IT","PT",tag=[字幕/歌词] 副语言（目标语言）,desc=选择需要翻译成的目标语言（默认中文简体）。
Position = select,"Forward","Reverse",tag=[字幕] 主语言（源语言）字幕位置,desc=主语言（源语言）字幕的显示位置。
Vendor = select,"Google","Microsoft","DeepL",tag=[翻译器] 服务商API,desc=请选择翻译器所使用的服务商API，更多翻译选项请使用BoxJs。
ShowOnly = switch,false,tag=[翻译器] 只显示“自动翻译”字幕,desc=是否仅显示“自动翻译”字幕，不显示源语言字幕。
Storage = select,"Argument","PersistentStore","database",tag=[储存] 配置类型,desc=默认优先使用插件配置，其次使用设置面板或 BoxJS 保存的配置，最后使用脚本默认配置。
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。

[Rule]
# 阻止 YouTube / YouTube Music 使用 QUIC (UDP 443) 绕过 Loon MitM 解密
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,UDP)),REJECT

[Rewrite]
# 拦截 Onesie initplayback 请求以触发标准字幕加载流程
^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*(oad|ack)=.+)$ reject-dict

[Script]
http-request ^https:\/\/dualsubs\.github\.io\/api\/(?:get|set|delete)(?:\?.*)?$ requires-body=1, script-path=https://github.com/NSNanoCat/PreferencePanes/releases/download/v1.3.1/api.js, tag=PreferencePanes.API
# YouTube Player & GetWatch
http-request ^https?:\/\/(www|m|tv|music)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/request.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTube.Player.request.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/(www|m|tv|music)\.youtube\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/response.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTube.Player.response.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-request ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/request.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTube.Player.request.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/response.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTube.Player.response.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_watch(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/response.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTube.GetWatch.response.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
# YouTube TimedText (合成双语字幕 & 翻译双语字幕合二为一)
http-request ^https?:\/\/(www|m|music)\.youtube\.com\/api\/timedtext(\?.+)?$ script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/request.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTube.TimedText.request, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/(www|m|music)\.youtube\.com\/api\/timedtext(\?.+)?$ requires-body=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/response.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTube.TimedText.response, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]

# YouTube Music Lyrics (Browse & GetPanel 双语歌词合二为一)
http-request ^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$ requires-body=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/request.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTubeMusic.Browse.request.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-request ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/request.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTube.Browse.request.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/music\.youtube\.com\/youtubei\/v1\/browse(\?.+)?$ requires-body=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/response.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTubeMusic.Translate.Lyrics.response.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/browse(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/response.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTubeMusic.Translate.Lyrics.response.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_panel(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/response.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTubeMusic.GetPanel.Translate.Lyrics.response.proto, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?:\/\/music\.youtube\.com\/youtubei\/v1\/get_panel(\?.+)?$ requires-body=1, script-path=https://raw.githubusercontent.com/JohnMuyuan/YoutubeAutoTranslation/main/dist/response.bundle.js?v=1.6.2, tag=🍿️ DualSubs.YouTubeMusic.GetPanel.Translate.Lyrics.response.json, argument=[{Type},{Types},{AutoCC},{Source},{Target},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]

[MITM]
hostname = dualsubs.github.io, www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, -redirector*.googlevideo.com, *.googlevideo.com
